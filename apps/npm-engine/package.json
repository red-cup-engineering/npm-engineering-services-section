{
  "name": "@red-cup-engineering/npm-engine",
  "version": "0.1.1-dev.0",
  "type": "module",
  "description": "Plan and apply npm package normalization against released registry metadata.",
  "exports": {
    "./package-normalization": "./src/package-normalization.mjs"
  },
  "bin": {
    "npm-engine": "./scripts/npm-engine.mjs"
  },
  "files": [
    "src",
    "scripts"
  ],
  "scripts": {
    "check": "node --check src/package-normalization.mjs && node --check src/normalization-source.mjs && node --check src/registry-configuration.mjs && node --check scripts/npm-engine.mjs"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "dependencies": {
    "@red-cup-engineering/computer-file-engineering-services-section": "^0.8.10",
