    "@red-cup-engineering/jsnode-cross-package-module-edge-normalization-service": "^0.1.3",
    "@red-cup-engineering/jsnode-package-body-observation-service": "^0.1.2",
    "@red-cup-engineering/jsnode-package-dependency-normalization-service": "^0.2.2",
    "@red-cup-engineering/jsnode-package-identity-normalization-service": "^1.0.0",
    "@red-cup-engineering/jsnode-package-owner-projection-service": "^0.1.2",
    "@red-cup-engineering/npm-package-manifest-normalization-service": "^0.2.4",
    "@red-cup-engineering/npm-registry-engineering-services-section": "^0.1.7",
    "@red-cup-engineering/signcell": "^0.17.7",
    "semver": "7.7.2",
    "typescript": "5.9.3",
    "@red-cup-engineering/semiotic-content-address-system": "0.1.7-dev.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/npm-engineering-services-section.git",
