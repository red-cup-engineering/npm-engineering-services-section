[Unit]
Description=561 Group private npm registry on Cold Red Gate
Documentation=file:///home/emsenn/services/verdaccio-561-group/README.md
After=network.target

[Service]
WorkingDirectory=/home/emsenn/services/verdaccio-561-group
ExecStartPre=/usr/bin/node scripts/configure-npm-scope-routing.mjs --config content/config/cold-red-gate.yaml
ExecStartPre=/usr/bin/node scripts/harden-htpasswd-permissions.mjs
ExecStart=/usr/bin/node node_modules/verdaccio/build/lib/cli/cli.mjs --config content/config/cold-red-gate.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
