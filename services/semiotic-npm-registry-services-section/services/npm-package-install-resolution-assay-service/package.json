{
  "name": "@red-cup-engineering/npm-package-install-resolution-assay-service",
  "version": "0.1.1",
  "description": "Installs selected exact npm package surfaces into isolated temporary consumers with lifecycle scripts disabled, reporting dependency-resolution/install-closure receipts without claiming runtime correctness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-code-engineering-services-section.git",
    "directory": "services/javascript-engineering-services-section/services/javascript-node-services-section/services/jsnode-packaging-services-section/services/npm-services-section/services/semiotic-npm-registry-services-section/services/npm-package-install-resolution-assay-service"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": "./src/npm-package-install-resolution-assay.mjs",
  "bin": {
    "assay-npm-package-install-resolution": "scripts/assay-npm-package-install-resolution.mjs"
  },
  "files": [
    "src",
    "scripts",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/npm-package-install-resolution-assay.mjs && node --check scripts/assay-npm-package-install-resolution.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
