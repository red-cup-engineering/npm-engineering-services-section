{
  "name": "@red-cup-engineering/consumer-dependency-closure-installation-service",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Wires one consumer service to the Union private package registry and installs its complete dependency closure, returning one typed receipt that binds every declared bare import to a resolved provider.",
  "keywords": [
    "dependency-closure",
    "npm-registry",
    "union-private-registry",
    "capability-cell",
    "deterministic"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/consumer-dependency-closure-installation-service.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "node --check src/install-consumer-dependency-closure.mjs && node --check scripts/install-consumer-dependency-closure.mjs && node --check scripts/check-test-summary.mjs",
    "test": "node --test --test-reporter=tap test/*.test.mjs"
  }
}
