{
  "name": "@red-cup-engineering/disk-package-observation-app",
  "version": "0.1.0",
  "description": "Reads the packages present under a machine path by walking it and slicing to JSNode manifests. Use when charting what a disk tree contains against what a registry has published.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./src/observe-disk-packages.mjs",
  "files": [
    "src",
    "scripts",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "observe-disk-packages": "./scripts/observe-disk-packages.mjs"
  },
  "scripts": {
    "check": "check-package-syntax",
    "test": "run-package-tests",
    "verify": "npm run check && npm test",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/computer-filepath-engineering-services-section": "workspace:*",
    "@red-cup-engineering/javascript-node-services-section": "workspace:*"
  },
  "devDependencies": {
    "@red-cup-engineering/jsnode-package-services-section": "workspace:*"
  }
}
