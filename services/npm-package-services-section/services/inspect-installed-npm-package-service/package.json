{
  "name": "@red-cup-engineering/inspect-installed-npm-package-service",
  "version": "0.3.2",
  "description": "Reads the identity, declared faces, JavaScript syntax, and reachable import closure of one installed npm package.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./scripts/inspect-installed-npm-package.mjs",
  "bin": {
    "inspect-installed-npm-package": "scripts/inspect-installed-npm-package.mjs"
  },
  "files": [
    "scripts",
    "src",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/json-services-section": "0.4.0",
    "@red-cup-engineering/jsonl-services-section": "0.1.0",
    "@red-cup-engineering/javascript-file-import-services-section": "0.1.1",
    "@red-cup-engineering/javascript-node-services-section": "0.3.2",
    "@red-cup-engineering/read-javascript-file-export-documentation-service": "0.1.5"
  },
  "scripts": {
    "test": "run-package-tests",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "check": "check-package-syntax"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@red-cup-engineering/jsnode-package-services-section": "0.2.4"
  }
}
