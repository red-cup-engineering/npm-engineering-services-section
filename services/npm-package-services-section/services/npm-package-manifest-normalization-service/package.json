{
  "name": "@red-cup-engineering/npm-package-manifest-normalization-service",
  "version": "0.2.0",
  "description": "Normalizes one npm package manifest without inventing package identity or version values.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-code-engineering-services-section.git",
    "directory": "services/javascript-engineering-services-section/services/javascript-node-services-section/services/jsnode-packaging-services-section/services/npm-services-section/services/npm-package-services-section/services/npm-package-manifest-normalization-service"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./src/normalize-jsnode-package-manifest.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "normalize-jsnode-package-manifest": "scripts/normalize-jsnode-package-manifest.mjs"
  },
  "files": [
    "src",
    "scripts",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/json-services-section": "0.4.0",
    "@red-cup-engineering/npm-package-manifest-admission-service": "0.3.0",
    "@red-cup-engineering/npm-package-version-admission-service": "0.2.0"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "check": "check-package-syntax",
    "test": "run-package-tests",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  }
}
