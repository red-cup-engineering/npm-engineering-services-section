{
  "name": "@red-cup-engineering/npm-cache-release-recovery-service",
  "version": "0.0.0",
  "description": "Audits explicit npm package-lock evidence against a local npm cache and recovers only integrity-verified exact release tarballs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-code-engineering-services-section.git",
    "directory": "services/javascript-engineering-services-section/services/javascript-node-services-section/services/jsnode-packaging-services-section/services/npm-services-section/services/npm-cache-services-section/services/npm-cache-release-recovery-service"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": "./src/recover-npm-cache-releases.mjs",
  "files": [
    "src",
    "scripts",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "recover-npm-cache-releases": "./scripts/recover-npm-cache-releases.mjs"
  },
  "scripts": {
    "check": "node --check src/recover-npm-cache-releases.mjs && node --check scripts/recover-npm-cache-releases.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "cacache": "20.0.4",
    "@red-cup-engineering/javascript-file-services-section": "workspace:*"
  }
}
